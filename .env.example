# FRED: free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ECON_MODEL=claude-opus-5-5

# LangSmith tracing (optional, free tier at https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=macrodesk

# Logging
ECON_LOG_LEVEL=INFO

# Optional: Postgres for checkpoints + memory (multi-machine). Leave unset for local SQLite.
DATABASE_URL=
